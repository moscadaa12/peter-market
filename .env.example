# Conexión a Supabase (PostgreSQL)
# Obtenerla en: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Secreto para firmar tokens JWT
# En producción, usar una clave segura (ej: openssl rand -hex 32)
JWT_SECRET=mi-clave-secreta-cambiar-en-produccion

# Supabase Storage (para imágenes de productos)
# SUPABASE_URL: Project Settings > API > Project URL
# SUPABASE_SERVICE_KEY: Project Settings > API > service_role key (¡mantener secreta!)
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Orígenes permitidos por CORS (separados por coma)
# En producción, poner la URL de Vercel: https://tu-app.vercel.app
CORS_ORIGIN=http://localhost:5173
