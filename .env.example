# ── API (Backend) ─────────────────────────────────────────────
# Obtener DATABASE_URL en Supabase: Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

# Generar con: openssl rand -hex 32
JWT_SECRET=mi-clave-secreta-cambiar-en-produccion

# Supabase project URL (sin /rest/v1/)
SUPABASE_URL=https://project.supabase.co

# Supabase service_role secret (Settings > API > service_role)
SUPABASE_SECRET_KEY=sb_secret_...

# En producción, poner la URL de Vercel
CORS_ORIGIN=http://localhost:5173

# ── Frontend (Vite) ──────────────────────────────────────────
# Las variables VITE_ son inyectadas por Vite en el frontend
VITE_SUPABASE_URL=https://project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
