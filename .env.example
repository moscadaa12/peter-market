# Secreto para firmar tokens JWT
# En producción, usar una clave segura (ej: openssl rand -hex 32)
JWT_SECRET=mi-clave-secreta-cambiar-en-produccion

# Supabase (API + DB todo por HTTPS)
# SUPABASE_URL: Project Settings > API > Project URL
# SUPABASE_SECRET_KEY: Settings > API > Secret keys > service_role (empieza con sb_secret_)
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Orígenes permitidos por CORS (separados por coma)
# En producción, poner la URL de Vercel: https://tu-app.vercel.app
CORS_ORIGIN=http://localhost:5173
